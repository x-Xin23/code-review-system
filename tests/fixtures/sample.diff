+import pickle
+import os
+
+SECRET_KEY = "prod-secret-2024-do-not-commit"
+
+def save_session(data):
+    """Save user session to file."""
+    with open('/tmp/session.pkl', 'wb') as f:
+        pickle.dump(data, f)
+
+def load_session():
+    """Load user session from file."""
+    with open('/tmp/session.pkl', 'rb') as f:
+        return pickle.load(f)
+
+def ping(host):
+    """Ping a host."""
+    return os.system(f"ping -c 1 {host}")
